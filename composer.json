{
  "name": "coblax/cbt-exam-system",
  "description": "WordPress CBT plugin with JWT authentication",
  "type": "wordpress-plugin",
  "require": {
    "firebase/php-jwt": "^6.10",
    "phpoffice/phpspreadsheet": "^2.2"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "CbtExamSystem\\": "includes/"
    }
  },
  "config": {
    "process-timeout": 900
  },
  "scripts": {
    "test:php": "vendor/bin/phpunit -c phpunit.xml.dist"
  }
}
